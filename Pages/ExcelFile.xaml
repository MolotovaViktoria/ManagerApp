<Page x:Class="ManagerApp.Pages.ExcelFile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Просмотр Excel файла" 
      Background="White"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель шагов -->
        <Grid Grid.Row="0" 
              Background="#F5F5F5"
              Height="70"
              VerticalAlignment="Center"
              Margin="15,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пустое пространство слева -->
                <Grid Grid.Column="0"/>

                <!-- Шаг 1: Загрузка заявки (активный) -->
                <Border Grid.Column="1"
                        Background="#E2542A"
                        CornerRadius="8"
                        Opacity="0.5"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Загрузка заявки"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="2"/>

                <!-- Шаг 2: Анализ данных (неактивный) -->
                <Border Grid.Column="3"
                        Background="#E2542A"
                        CornerRadius="8"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Сопоставление товаров"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="4"/>

                <!-- Шаг 3: Проверка (неактивный) -->
                <Border Grid.Column="5"
                        Background="#E2542A"
                        CornerRadius="8"
                        Opacity="0.5"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Редактирование цены"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="6"/>

                <!-- Шаг 4: Результат (неактивный) -->
                <Border Grid.Column="7"
                        Background="#E2542A"
                        CornerRadius="8"
                        Opacity="0.5"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Формирование счета"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Пустое пространство справа -->
                <Grid Grid.Column="8"/>
            </Grid>
        </Grid>

        <!-- Контентная область -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="10,5,10,5"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Слева: Таблица Excel (теперь 70%) -->
                    <ColumnDefinition Width="0.7*"/>
                    <!-- Справа: Список выбранных ячеек (теперь 30%) -->
                    <ColumnDefinition Width="0.3*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая часть - ТАБЛИЦА EXCEL -->
                <Border Grid.Column="0"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель инструментов таблицы -->
                        <Border Grid.Row="0"
                                Background="#F5F5F5"
                                Padding="10"
                                Margin="0,0,0,10"
                                CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Таблица Excel:"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <ComboBox x:Name="cmbSheets"
                                          Width="150"
                                          Margin="0,0,10,0"
                                          SelectionChanged="cmbSheets_SelectionChanged"
                                          DisplayMemberPath="Key"/>

                                <TextBlock x:Name="txtTableInfo"
                                           VerticalAlignment="Center"
                                           Foreground="#666"
                                           Margin="0,0,10,0"/>

                                <Button x:Name="btnLoadExcel"
                                        Content="Открыть другой"
                                        Background="#E2542A"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="10,5"
                                        Click="btnLoadExcel_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Таблица Excel -->
                        <Border Grid.Row="1"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="5">
                            <DataGrid x:Name="dgExcelData"
                                      AutoGenerateColumns="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="CellOrRowHeader"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserSortColumns="True"
                                      AlternatingRowBackground="#F9F9F9"
                                      RowBackground="White"
                                      GridLinesVisibility="All"
                                      BorderThickness="0"
                                      HeadersVisibility="All"
                                      SelectionChanged="dgExcelData_SelectionChanged"
                                      LoadingRow="dgExcelData_LoadingRow"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      MouseUp="dgExcelData_MouseUp">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2542A"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFE0D0"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Правая часть - ВЫБРАННЫЕ ЯЧЕЙКИ -->
                <Border Grid.Column="1"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1,0,0,0"
                        Background="#F8F9FA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок -->
                        <Border Grid.Row="0"
                                Background="#E2542A"
                                Padding="15,10">
                            <TextBlock Text="ВЫБРАННЫЕ ЯЧЕЙКИ"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Список выбранных ячеек -->
                        <Border Grid.Row="1"
                                Margin="10">
                            <ListView x:Name="lvSelectedCells"
                                      Background="White"
                                      BorderBrush="#E0E0E0"
                                      BorderThickness="1"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Лист" Width="60">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SheetName}" 
                                                               Margin="5,2"
                                                               FontWeight="SemiBold"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Строка" Width="50">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Row}" 
                                                               Margin="5,2"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Столбец" Width="60">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ColumnName}" 
                                                               Margin="5,2"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Значение" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Value}" 
                                                               Margin="5,2"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFF0F0"/>
                                            </Trigger>
                                            <EventTrigger RoutedEvent="MouseDoubleClick">
                                                <EventTrigger.Actions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                            To="#FFE0D0"
                                                                            Duration="0:0:0.1"
                                                                            AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger.Actions>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Border>

                        <!-- Панель управления -->
                        <Border Grid.Row="2"
                                Background="#F5F5F5"
                                Padding="10"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Text="Управление:"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>

                                <WrapPanel>
                                    <Button x:Name="btnClearAllSelections"
                                            Content="Очистить всё"
                                            Background="#FF5252"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="10,5"
                                            Margin="0,0,5,5"
                                            Click="btnClearAllSelections_Click"/>

                                    <Button x:Name="btnRemoveSelected"
                                            Content="Удалить выбранное"
                                            Background="#2196F3"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="10,5"
                                            Margin="0,0,5,5"
                                            Click="btnRemoveSelected_Click"/>

                                    <Button x:Name="btnExportSelections"
                                            Content="Экспорт"
                                            Background="#4CAF50"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="10,5"
                                            Margin="0,0,0,5"
                                            Click="btnExportSelections_Click"/>
                                </WrapPanel>

                                <!-- Информация -->
                                <Border Background="#E8F5E8"
                                        CornerRadius="5"
                                        Padding="8"
                                        Margin="0,10,0,0"
                                        BorderBrush="#4CAF50"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Статистика:"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock x:Name="txtSelectionStats"
                                                   Text="Выбрано: 0 ячеек"
                                                   FontSize="11"
                                                   Foreground="#2E7D32"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>