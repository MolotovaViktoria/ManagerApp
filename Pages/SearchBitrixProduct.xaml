<Window x:Class="ManagerApp.Pages.SearchBitrixProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManagerApp.Pages"
        mc:Ignorable="d"
        Title="Поиск товара"
        Height="900"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White"
            BorderBrush="#E2542A"
            BorderThickness="2"
            CornerRadius="10"
            Margin="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <Border Grid.Row="0"
                    Background="#E2542A"
                    CornerRadius="8,8,0,0"
                    Padding="20,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ПОИСК ТОВАРА В BITRIX"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <!-- Кнопка закрытия -->
                    <Button Grid.Column="1"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="btnClose_Click"
                            Cursor="Hand">
                        <TextBlock Text="✕"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Поле поиска (стиль Google) -->
                <Border Grid.Row="0" 
                        Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Иконка лупы -->
                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                Margin="5,0,0,0">
                            <TextBlock Text="🔍"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Поле ввода -->
                        <TextBox x:Name="txtSearch"
                                 Grid.Column="1"
                                 Height="40"
                                 Padding="10,10,40,10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 KeyDown="txtSearch_KeyDown"
                                 TextChanged="txtSearch_TextChanged"
                                 BorderBrush="#DFE1E5"
                                 BorderThickness="1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#DADCE0"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#1A73E8"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Кнопка очистки (появляется при наличии текста) -->
                        <Button x:Name="btnClearSearch"
                                Grid.Column="1"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Click="btnClearSearch_Click"
                                Visibility="Collapsed">
                            <TextBlock Text="×"
                                       FontSize="18"
                                       Foreground="#70757A"/>
                        </Button>

                        <!-- Кнопка поиска -->
                        <Button x:Name="btnSearch"
                                Grid.Column="2"
                                Content="Поиск"
                                Width="100"
                                Height="40"
                                Margin="10,0,0,0"
                                Background="#1A73E8"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"

                                Cursor="Hand"
                                Click="btnSearch_Click"/>
                    </Grid>
                </Border>

                <!-- Фильтры категорий -->
                <Border Grid.Row="1"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,1,0,1"
                        Margin="0,0,0,15"
                        Padding="0,10,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Фильтры по категориям:"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#5F6368"
                                   Margin="0,0,0,8"/>

                        <!-- Контейнер для чекбоксов категорий -->
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Height="60">
                            <StackPanel x:Name="spCategories"
                                        Orientation="Horizontal"
                                        Margin="0,5,0,0"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Результаты поиска -->
                <Border Grid.Row="2"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Margin="0,0,0,10">
                    <DataGrid x:Name="dgSearchResults"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              CanUserReorderColumns="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                                Binding="{Binding ProductId}"
                                                Width="60"/>
                            <DataGridTextColumn Header="Товар" 
                                                Binding="{Binding ProductName}"
                                                Width="*"
                                                MinWidth="200"/>
                            <DataGridTextColumn Header="Категория" 
                                                Binding="{Binding CategoryName}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Нижний раздел" 
                        Binding="{Binding LowerSectionName}"
                        Width="150"/>
                          
                            <DataGridTemplateColumn Width="100" Header="Выбор">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Выбрать"
                                                Width="80"
                                                Height="30"
                                                Background="#E2542A"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                BorderThickness="0"

                                                Cursor="Hand"
                                                Click="btnSelectFromGrid_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Пагинация и статус -->
                <Border Grid.Row="3"
                        Background="#F5F5F5"
                        Padding="10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая часть: кнопка "Назад" -->
                        <Button x:Name="btnPrevPage"
                                Grid.Column="0"
                                Content="◀ Назад"
                                Width="80"
                                Height="30"
                                Background="#CCCCCC"
                                Foreground="#333333"
                                FontWeight="Bold"
                                BorderThickness="0"

                                IsEnabled="False"
                                Cursor="Hand"
                                Click="btnPrevPage_Click"/>

                        <!-- Центр: информация о странице -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="txtStatus"
                                       FontSize="12"
                                       Foreground="#5F6368"/>
                        </StackPanel>

                        <!-- Правая часть: кнопка "Вперед" -->
                        <Button x:Name="btnNextPage"
                                Grid.Column="2"
                                Content="Вперед ▶"
                                Width="80"
                                Height="30"
                                Background="#CCCCCC"
                                Foreground="#333333"
                                FontWeight="Bold"
                                BorderThickness="0"

                                IsEnabled="False"
                                Cursor="Hand"
                                Click="btnNextPage_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Кнопки действий -->
            <Border Grid.Row="2"
                    Background="#F5F5F5"
                    CornerRadius="0,0,8,8"
                    Padding="20,15">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button x:Name="btnCancel"
                            Content="Отмена"
                            Width="100"
                            Height="40"
                            Background="#CCCCCC"
                            Foreground="#333333"
                            FontWeight="Bold"
                            BorderThickness="0"

                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Click="btnCancel_Click"/>

                    <Button x:Name="btnSelect"
                            Content="Выбрать"
                            Width="100"
                            Height="40"
                            Background="#E2542A"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"

                            Cursor="Hand"
                            IsEnabled="False"
                            Click="btnSelect_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>