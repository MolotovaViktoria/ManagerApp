<Page x:Class="ManagerApp.Pages.History"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="История счетов">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка страницы -->
        <Border Grid.Row="0"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <TextBlock Text="ИСТОРИЯ СЧЕТОВ"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основная область с историей -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="20,20,20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Панель поиска и управления -->
                <Border Grid.Row="0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Количество файлов -->
                        <TextBlock x:Name="txtFilesCount"
                                   Grid.Column="0"
                                   Text="Загрузка..."
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#666666"
                                   VerticalAlignment="Center"/>

                        <!-- Поле поиска -->
                        <TextBox x:Name="txtSearch"
                                 Grid.Column="1"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0,35,0"
                                 TextChanged="txtSearch_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="#F8F8F8"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#E2542A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="3"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="placeholder"
                                                   Text="Поиск по названию или дате..."
                                                   Foreground="#999999"
                                                   FontStyle="Italic"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                        <!-- Кнопка обновления -->
                        <Button x:Name="btnRefresh"
                                Grid.Column="2"
                                Width="120"
                                Height="40"
                                Content="ОБНОВИТЬ"
                                Background="#F0F0F0"
                                Foreground="#333333"
                                FontWeight="SemiBold"
                                FontSize="14"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0"
                                Click="btnRefresh_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>


                    </Grid>
                </Border>

                <!-- Список счетов -->
                <Grid Grid.Row="1">
                    <!-- Сообщение когда нет файлов -->
                    <TextBlock x:Name="txtNoFiles"
                               Text="История счетов пуста"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#999999"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <!-- ListBox со счетами -->
                    <ListBox x:Name="listInvoices"
         BorderThickness="0"
         Background="White"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         SelectionChanged="listInvoices_SelectionChanged"
         MouseDoubleClick="listInvoices_MouseDoubleClick"  
                        Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0"
                                        BorderThickness="0,0,0,1"
                                        Padding="20,15"
                                        Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Название файла -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding FileName}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,5"/>

                                        <!-- Дата и время -->
                                        <StackPanel Grid.Row="1" Grid.Column="0"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="Дата: "
                                                       FontSize="13"
                                                       Foreground="#666666"/>
                                            <TextBlock Text="{Binding Date}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"
                                                       Margin="0,0,15,0"/>

                                            <TextBlock Text="Время создания: "
                                                       FontSize="13"
                                                       Foreground="#666666"/>
                                            <TextBlock Text="{Binding CreatedTimeFormatted}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"
                                                       Margin="0,0,15,0"/>

                                            <TextBlock Text="Размер: "
                                                       FontSize="13"
                                                       Foreground="#666666"/>
                                            <TextBlock Text="{Binding FileSizeFormatted}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#333333"/>
                                        </StackPanel>

                                        <!-- Путь к файлу -->
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding FullPath}"
                                                   FontSize="12"
                                                   Foreground="#999999"
                                                   FontStyle="Italic"
                                                   TextWrapping="NoWrap"
                                                   MaxWidth="300"
                                                   Margin="20,0,0,0"
                                                   ToolTip="{Binding FullPath}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#FFF5F5"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8F8F8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

               
            </Grid>
        </Border>

        <!-- Панель кнопок -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="20,15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

              

            </Grid>
        </Border>
    </Grid>
</Page>