<Page x:Class="ManagerApp.Pages.ComparisonProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Сопоставление товаров"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель шагов -->
        <Grid Grid.Row="0" 
              Background="#F5F5F5"
              Height="80"
              Margin="0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Background="#E2542A" CornerRadius="6" Opacity="0.5" Width="185" Height="50" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="White" Margin="0,0,8,0">
                            <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#E2542A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Загрузка заявки" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#E2542A" CornerRadius="6" Width="185" Height="50" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="White" Margin="0,0,8,0">
                            <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="#E2542A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Сопоставление товаров" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#E2542A" CornerRadius="6" Width="185" Height="50" Opacity="0.5" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="White" Margin="0,0,8,0">
                            <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="#E2542A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Редактирование цены" FontSize="13" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#E2542A" CornerRadius="6" Opacity="0.5" Width="185" Height="50" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="White" Margin="0,0,8,0">
                            <TextBlock Text="4" FontSize="12" FontWeight="Bold" Foreground="#E2542A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Формирование счета" FontSize="13" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Основная область с таблицей -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="20,10,20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок таблицы -->
                <Border Grid.Row="0"
                        Background="#F8F8F8"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="СОПОСТАВЛЕНИЕ ТОВАРОВ" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                    </Grid>
                </Border>

                <!-- Панель прогресса -->
                <Border x:Name="ProgressPanel" 
                        Grid.Row="1"
                        Background="#FFF3E0"
                        BorderBrush="#E2542A"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="15,10,15,5"
                        Padding="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⏳" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,10,0">
                            <TextBlock x:Name="ProgressText" Text="Поиск товаров..." FontSize="13" FontWeight="SemiBold"
                                       Foreground="#E2542A" Margin="0,0,0,3"/>
                            <ProgressBar x:Name="ProgressBar" Height="15" Minimum="0" Maximum="100" Value="0"
                                         Foreground="#E2542A" Background="#FFE0B2"/>
                        </StackPanel>
                        <TextBlock x:Name="ProgressCounter" Grid.Column="2" Text="0/0" FontSize="13" FontWeight="Bold"
                                   Foreground="#E2542A" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Панель быстрого добавления -->
                <Border Grid.Row="2"
                        Background="#F9F9F9"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="15,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Добавить товар:" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#333333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtNewProduct" Grid.Column="1" Margin="0,0,10,0" Padding="10,8" FontSize="14"
                                 VerticalContentAlignment="Center" BorderBrush="#CCCCCC" BorderThickness="1"
                                 VerticalAlignment="Center" KeyUp="TxtNewProduct_KeyUp" TextChanged="TxtNewProduct_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Border.CornerRadius" Value="4"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button x:Name="btnQuickAdd" Grid.Column="2" Content="Добавить" Width="100" Height="36"
                                Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="13"
                                Click="BtnQuickAdd_Click" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45A049"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#CCCCCC"/>
                                            <Setter Property="Foreground" Value="#888888"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="btnClearAll" Grid.Column="3" Content="Очистить все" Width="110" Height="36"
                                Background="#F44336" Foreground="White" FontWeight="Bold" FontSize="13"
                                Click="BtnClearAll_Click" Cursor="Hand" ToolTip="Удалить все товары из списка">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D32F2F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Таблица товаров -->
                <DataGrid x:Name="dataGridProducts"
                          Grid.Row="4"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="White"
                          BorderThickness="0"
                          HorizontalGridLinesBrush="#F0F0F0"
                          VerticalGridLinesBrush="#F0F0F0"
                          ItemsSource="{Binding ProductItems}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MaxHeight="500">

                    <DataGrid.Columns>
                        <!-- Колонка 0: Номер -->
                        <DataGridTextColumn Header="№"
                                            Binding="{Binding Index}"
                                            Width="50"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="10,10"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Колонка 1: Товар из заявки -->
                        <DataGridTemplateColumn Header="ТОВАР ИЗ ЗАЯВКИ"
                                                Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding OriginalProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinHeight="40"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             FontSize="13"
                                             Foreground="#333333"
                                             BorderThickness="1"
                                             BorderBrush="#CCCCCC"
                                             TextChanged="ProductTextBox_TextChanged"
                                             VerticalScrollBarVisibility="Auto">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Border.CornerRadius" Value="4"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Padding" Value="8,8"/>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Колонка 2: Описание (растягивается под содержимое) -->
                        <DataGridTemplateColumn Header="ОПИСАНИЕ"
                                                Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinHeight="40"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             FontSize="12"
                                             Foreground="#555555"
                                             BorderBrush="#CCCCCC"
                                             BorderThickness="1"
                                             Background="#FFF9F9"
                                             TextChanged="DescriptionTextBox_TextChanged"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="{Binding Description}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Border.CornerRadius" Value="4"/>
                                                <Setter Property="Padding" Value="8,8"/>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Колонка 3: Выбор товара из Bitrix -->
                        <DataGridTemplateColumn Header="ВЫБОР ТОВАРА ИЗ BITRIX"
                                                Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="5,5"
                                              ItemsSource="{Binding BitrixProducts}"
                                              DisplayMemberPath="ProductName"
                                              SelectedItem="{Binding SelectedBitrixProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              MaxDropDownHeight="400" 
                                              IsEditable="True"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              FontSize="12"
                                              MinHeight="35"
                                              BorderBrush="#CCCCCC"
                                              DropDownOpened="ComboBox_DropDownOpened"
                                              KeyUp="ComboBox_KeyUp"
                                              SelectionChanged="ComboBox_SelectionChanged">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="Border.CornerRadius" Value="4"/>
                                                <Setter Property="Padding" Value="5,0"/>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical" Margin="5">
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" 
                                                               TextWrapping="Wrap" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="Gray"/>
                                                        <TextBlock Text=" • " FontSize="10" Foreground="Gray"/>
                                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:#,##0.00} ₽'}" FontSize="10"/>
                                                        
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Колонка 4: Количество -->
                        <DataGridTemplateColumn Header="КОЛИЧЕСТВО"
                                                Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="70"
                                             MinHeight="35"
                                             FontSize="13"
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="#CCCCCC"
                                             BorderThickness="1"
                                             Padding="5,0"
                                             PreviewTextInput="QuantityTextBox_PreviewTextInput"
                                             LostFocus="QuantityTextBox_LostFocus"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Border.CornerRadius" Value="4"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#E2542A"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Колонка 5: Единица измерения -->
                        <DataGridTemplateColumn Header="ЕД. ИЗМ."
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Path=DataContext.AllMeasures, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                              SelectedValue="{Binding SelectedMeasureId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="ID"
                                              DisplayMemberPath="SYMBOL_RUS"
                                              Width="85"
                                              MinHeight="35"
                                              FontSize="12"
                                              VerticalContentAlignment="Center"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsEnabled="True">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="Border.CornerRadius" Value="4"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                                <Setter Property="Padding" Value="5,0"/>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Колонка 6: Действие -->
                        <DataGridTemplateColumn Header="ДЕЙСТВИЕ"
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="35"
                                            Height="35"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding AddCommand}"
                                            CommandParameter="{Binding}" 
                                            ToolTip="Открыть расширенный поиск"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand">
                                        <Image Source="/Image/changeButton.png" 
                                               Width="24"
                                               Height="24"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Колонка 7: Удалить -->
                        <DataGridTemplateColumn Header="УДАЛИТЬ"
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="35"
                                            Height="35"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding RemoveCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Удалить товар"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand">
                                        <Grid>
                                            <Ellipse Width="28" Height="28" Fill="#FF5252"/>
                                            <TextBlock Text="×" FontSize="18" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F0F0F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="MinHeight" Value="50"/>
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#A6A7A8"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#333333"/>
                            </Style.Resources>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Панель кнопок навигации -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="20,15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnBack" Grid.Column="1" Content="НАЗАД" Width="140" Height="45"
                        Background="#E2542A" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0" Click="btnBack_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="btnNext" Grid.Column="3" Content="ДАЛЕЕ" Width="140" Height="45"
                        Background="#E2542A" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0" Click="btnNext_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>