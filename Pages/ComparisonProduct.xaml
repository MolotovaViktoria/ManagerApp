<Page x:Class="ManagerApp.Pages.ComparisonProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Сопоставление товаров">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Панель шагов -->
        <Grid Grid.Row="0" 
      Background="#F5F5F5"
      Height="80"
      Margin="0">
            <!-- Центрирующий контейнер -->
            <StackPanel Orientation="Horizontal" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- Шаг 1: Загрузка заявки (активный) -->
                <Border Background="#E2542A"
                CornerRadius="6"
                 Opacity="0.5"
                Width="185"
                Height="50"
                Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- Номер шага -->
                        <Border Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="White"
                        Margin="0,0,8,0">
                            <TextBlock Text="1"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#E2542A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <!-- Название шага -->
                        <TextBlock Text="Загрузка заявки"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>



                <!-- Шаг 2: Сопоставление товаров (неактивный) -->
                <Border Background="#E2542A"
                CornerRadius="6"
                Width="185"
                Height="50"

                Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- Номер шага -->
                        <Border Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="White"
                        Margin="0,0,8,0">
                            <TextBlock Text="2"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#E2542A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <!-- Название шага -->
                        <TextBlock Text="Сопоставление товаров"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <!-- Шаг 3: Редактирование цены (неактивный) -->
                <Border Background="#E2542A"
                CornerRadius="6"
                Width="185"
                Height="50"
                                         Opacity="0.5"
                Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- Номер шага -->
                        <Border Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="White"
                        Margin="0,0,8,0">
                            <TextBlock Text="3"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#E2542A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <!-- Название шага -->
                        <TextBlock Text="Редактирование цены"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <!-- Шаг 4: Формирование счета (неактивный) -->
                <Border Background="#E2542A"
                CornerRadius="6"
                                                                 Opacity="0.5"
                Width="185"
                Height="50"

                Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- Номер шага -->
                        <Border Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="White"
                        Margin="0,0,8,0">
                            <TextBlock Text="4"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#E2542A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <!-- Название шага -->
                        <TextBlock Text="Формирование счета"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Основная область с таблицей -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="20,10,20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок таблицы -->
                <Border Grid.Row="0"
                        Background="#F8F8F8"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="СОПОСТАВЛЕНИЕ ТОВАРОВ"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>

                        <!-- Панель управления товарами -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                          
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Панель быстрого добавления -->
                <Border Grid.Row="1"
                        Background="#F9F9F9"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="15,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Добавить товар:"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="txtNewProduct"
         Grid.Column="1"
         Margin="0,0,10,0"
         Padding="10,8"
         FontSize="14"
         VerticalContentAlignment="Center"
         BorderBrush="#CCCCCC"
         BorderThickness="1"
         VerticalAlignment="Center"
         KeyUp="TxtNewProduct_KeyUp"
         TextChanged="TxtNewProduct_TextChanged">
                            <!-- Добавить эту строку -->
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Border.CornerRadius" Value="4"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button x:Name="btnQuickAdd"
                                Grid.Column="2"
                                Content="Добавить"
                                Width="100"
                                Height="36"
                                Background="#4CAF50"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="13"
                                Click="BtnQuickAdd_Click"
                                Cursor="Hand"
                                Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45A049"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#CCCCCC"/>
                                            <Setter Property="Foreground" Value="#888888"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnClearAll"
                                Grid.Column="3"
                                Content="Очистить все"
                                Width="110"
                                Height="36"
                                Background="#F44336"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="13"
                                Click="BtnClearAll_Click"
                                Cursor="Hand"
                                ToolTip="Удалить все товары из списка">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D32F2F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Заголовки колонок -->
                <Border Grid.Row="2"
                        Background="#F0F0F0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="ТОВАР ИЗ ЗАЯВКИ"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="ВЫБОР ТОВАРА ИЗ BITRIX"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="ДЕЙСТВИЕ"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Width="80"/>

                        <TextBlock Grid.Column="3"
                                   Text="УДАЛИТЬ"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#333333"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Width="100"/>
                    </Grid>
                </Border>

                <!-- Таблица товаров -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <ItemsControl x:Name="itemsControlProducts"
                                  ItemsSource="{Binding ProductItems}"
                                  Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1"
                                        Padding="20,12"
                                        Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Колонка 1: Товар из заявки -->
                                        <Border Grid.Column="0"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="0,0,1,0"
                                                Padding="10,0">
                                            <TextBlock Text="{Binding OriginalProduct}"
                                                       TextWrapping="Wrap"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       Foreground="#333333"/>
                                        </Border>

                                        <!-- Колонка 2: Выбор товара из Bitrix -->
                                        <ComboBox Grid.Column="1"
                                                  Margin="10,0"
                                                  ItemsSource="{Binding BitrixProducts}"
                                                  DisplayMemberPath="ProductName"
                                                  SelectedItem="{Binding SelectedBitrixProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  FontSize="14"
                                                  Height="38"
                                                  Padding="10,0"
                                                  BorderBrush="#CCCCCC"
                                                  DropDownOpened="ComboBox_DropDownOpened"
                                                  KeyUp="ComboBox_KeyUp">
                                            
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Border.CornerRadius" Value="4"/>
                                                </Style>
                                            </ComboBox.Style>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Vertical" 
                                                                Margin="2"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding ProductName}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" 
                                                                    HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding CategoryName}"
                                                                       FontSize="11"
                                                                       Foreground="Gray"/>
                                                            <TextBlock Text=" • "
                                                                       FontSize="11"
                                                                       Foreground="Gray"/>
                                                            <TextBlock Text="{Binding Price, StringFormat='Цена: {0:#,##0.00} ₽'}"
                                                                       FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Колонка 3: Кнопка расширенного поиска -->
                                        <Button Grid.Column="2"
                                                Width="50"
                                                Height="50"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding AddCommand}"
                                                CommandParameter="{Binding}" 
                                                ToolTip="Открыть расширенный поиск"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Cursor="Hand">
                                            <Grid>
                                                <Image Source="/Image/changeButton.png" 
                                                       Width="28"
                                                       Height="28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Button>

                                        <!-- Колонка 4: Кнопка удаления товара -->
                                        <Button Grid.Column="3"
                                                Width="40"
                                                Height="40"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding RemoveCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Удалить товар"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Cursor="Hand">
                                            <Grid>
                                                <Ellipse Width="32" Height="32" Fill="#FF5252"/>
                                                <TextBlock Text="×" 
                                                           FontSize="20" 
                                                           FontWeight="Bold" 
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Панель кнопок навигации -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="20,15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка "Назад" -->
                <Button x:Name="btnBack"
                        Grid.Column="1"
                        Content="НАЗАД"
                        Width="140"
                        Height="45"
                        Background="#E2542A"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Click="btnBack_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Кнопка "Далее" -->
                <Button x:Name="btnNext"
                        Grid.Column="3"
                        Content="ДАЛЕЕ"
                        Width="140"
                        Height="45"
                        Background="#E2542A"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Click="btnNext_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>