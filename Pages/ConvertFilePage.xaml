<Page x:Class="ManagerApp.Pages.ConvertFilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Конвертация файла в структурированную форму"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель шагов -->
        <Grid Grid.Row="0" 
              Background="#F5F5F5"
              Height="80">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Background="#E2542A" CornerRadius="6" Width="185" Height="50" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="White" Margin="0,0,8,0">
                            <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#E2542A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Загрузка файла" FontSize="13" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Background="#E2542A" CornerRadius="6" Width="185" Height="50" Opacity="0.5" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="White" Margin="0,0,8,0">
                            <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="#E2542A"/>
                        </Border>
                        <TextBlock Text="Конвертация" FontSize="13" FontWeight="Medium" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Background="#E2542A" CornerRadius="6" Width="185" Height="50" Opacity="0.5" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="White" Margin="0,0,8,0">
                            <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="#E2542A"/>
                        </Border>
                        <TextBlock Text="Скачивание" FontSize="13" FontWeight="Medium" Foreground="White"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Основная область -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="20,10,20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F8F8F8"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="20,15">
                    <TextBlock Text="КОНВЕРТАЦИЯ ФАЙЛА"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#333333"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Область загрузки файла -->
                <Border x:Name="FileUploadArea"
                        Grid.Row="1"
                        Background="#FFF8F5"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="20,20,20,10"
                        Padding="30"
                        Height="200"
                        AllowDrop="True"
                        DragEnter="FileUploadArea_DragEnter"
                        DragLeave="FileUploadArea_DragLeave"
                        Drop="FileUploadArea_Drop">
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="📁"
                                   FontSize="48"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Перетащите файл сюда или"
                                   FontSize="14"
                                   Foreground="#666666"
                                   Margin="0,10,0,5"
                                   HorizontalAlignment="Center"/>
                        <Button Content="Выберите файл"
                                Width="150"
                                Height="35"
                                Background="#E2542A"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Click="SelectFileButton_Click"
                                HorizontalAlignment="Center"
                                Margin="0,5"/>
                        <TextBlock x:Name="FileNameText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#4CAF50"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Прогресс -->
                <Border x:Name="ProgressPanel"
                        Grid.Row="1"
                        Background="#FFF3E0"
                        BorderBrush="#E2542A"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="20"
                        Padding="15"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⏳" FontSize="20" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ProgressText" Text="Конвертация..." FontSize="13" FontWeight="SemiBold"
                                       Foreground="#E2542A" Margin="0,0,0,5"/>
                            <ProgressBar x:Name="ProgressBar" Height="15" Minimum="0" Maximum="100" Value="0"
                                         Foreground="#E2542A" Background="#FFE0B2"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Результат - исправлено: TextBlock обернут в Border -->
                <Border Grid.Row="2"
                        Background="#F9F9F9"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="20,0,20,20"
                        Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                        <TextBlock x:Name="txtResult"
                                   Text="После конвертации здесь появится результат..."
                                   FontSize="13"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Панель кнопок -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="20,15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnBack"
                        Grid.Column="1"
                        Content="НАЗАД"
                        Width="140"
                        Height="45"
                        Background="#E2542A"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Click="btnBack_Click"/>

                <Button x:Name="btnDownload"
                        Grid.Column="3"
                        Content="СКАЧАТЬ ФАЙЛ"
                        Width="160"
                        Height="45"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Click="btnDownload_Click"
                        IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</Page>