<Window x:Class="ManagerApp.Pages.MainWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер товаров" 
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - кнопки -->
        <StackPanel Grid.Column="0">
            <Button x:Name="btnLoadRequest" Content="📁 Загрузить файл" 
            Click="btnLoadRequest_Click" Width="120" Height="30" Margin="5"/>
            <Button x:Name="btnSearchProducts" 
        Content="Найти товары в системе" 
        Click="btnSearchProducts_Click" 
        IsEnabled="True"
        Margin="5" 
        Padding="10,5"/>
        </StackPanel>

        <!-- Первый разделитель (между кнопками и первым текстовым блоком) -->
        <GridSplitter Grid.Column="1" 
                      HorizontalAlignment="Stretch" 
                      Width="5" 
                      Background="LightGray"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Левый текстовый блок -->
        <TextBox Grid.Column="2" 
                 x:Name="txtOutput1" 
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True"
                 Text="Левый текстовый блок..."/>

        <!-- Второй разделитель (между текстовыми блоками) -->
        <GridSplitter Grid.Column="3" 
                      HorizontalAlignment="Stretch" 
                      Width="5" 
                      Background="LightGray"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Правый текстовый блок -->
        <TextBox Grid.Column="4" 
                 x:Name="txtOutput2" 
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True"
                 Text="Средний текстовый блок..."/>

        <!-- Второй разделитель (между текстовыми блоками) -->
        <GridSplitter Grid.Column="5" 
                      HorizontalAlignment="Stretch" 
                      Width="5" 
                      Background="LightGray"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Правый текстовый блок -->
        <TextBox Grid.Column="6" 
                 x:Name="txtOutput3" 
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True"
                 Text="Правый текстовый блок..."/>
    </Grid>
</Window>