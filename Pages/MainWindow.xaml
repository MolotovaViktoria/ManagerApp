<Window x:Class="ManagerApp.Pages.MainWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер товаров" 
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - кнопки -->
        <StackPanel Grid.Column="0">
            <Button Content="📁 Загрузить файл" Click="btnLoadRequest_Click" Padding="15,8" Margin="0,0,5,0"/>
            <Button Content="🧠 Обучить модель" Click="TrainModelButton_Click" Padding="15,8" Margin="5,0,5,0" Background="#17a2b8" Foreground="White"/>
            <Button Content="👀 Предпросмотр данных" Click="btnPreviewTrainingData_Click" Padding="15,8" Margin="5,0,0,0" Background="#6c757d" Foreground="White"/>
        </StackPanel>
        <!-- Разделитель -->
        <GridSplitter Grid.Column="1" 
                      HorizontalAlignment="Stretch" 
                      Width="5" 
                      Background="LightGray"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Правая панель - текстовое поле для вывода данных -->
        <TextBox Grid.Column="2" 
                 x:Name="txtOutput" 
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True"
                 Text="Здесь будут данные из Битрикс..."/>
    </Grid>
</Window>