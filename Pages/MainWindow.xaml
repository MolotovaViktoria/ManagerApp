<Window x:Class="ManagerApp.Pages.MainWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер товаров" 
        MinHeight="500" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - синяя полоска с меню -->
        <Border Grid.Column="0" 
                Background="#002C78">
            <StackPanel>
                <!-- Кнопка гамбургер-меню -->
                <Button x:Name="btnMenu" 
                        Background="Transparent"
                        BorderThickness="0"
                        Width="30" 
                        Height="30"
                        Margin="5,5,5,0"
                        Click="btnMenu_Click">
                    <Button.Content>
                        <Grid Width="16" Height="14">
                            <Rectangle Fill="White" Height="2" Width="16" VerticalAlignment="Top"/>
                            <Rectangle Fill="White" Height="2" Width="16" VerticalAlignment="Center"/>
                            <Rectangle Fill="White" Height="2" Width="16" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button.Content>
                </Button>

                <!-- Выпадающее меню -->
                <StackPanel x:Name="pnlMenu" 
                           Orientation="Vertical" 
                           Visibility="Collapsed"
                           Background="Transparent"
                           Margin="5,5,5,0">

                    <!-- Удалены кнопки Debug, TestApi, CheckServer -->
                    <Button x:Name="btnTestBitrixCache" 
        Content="🧪 Тест Bitrix" 
        Click="btnTestBitrixCache_Click"
        Background="White"
        Foreground="Blue"
        BorderThickness="0"
        Margin="0,2" 
        Padding="5,2"
        HorizontalAlignment="Stretch"/>

                    <Button x:Name="btnLoadRequest" 
                            Content="📁 Загрузить файл" 
                            Click="btnLoadRequest_Click" 
                            Background="White"
                            Foreground="Black"
                            BorderThickness="0"
                            Margin="0,2" 
                            Padding="5,2"
                            HorizontalAlignment="Stretch"/>

                    <Button x:Name="btnSearchProducts" 
                            Content="Найти товары" 
                            Click="btnSearchProducts_Click" 
                            Background="White"
                            Foreground="Black"
                            BorderThickness="0"
                            IsEnabled="False"
                            Margin="0,2" 
                            Padding="5,2"
                            HorizontalAlignment="Stretch"/>

                    <Button x:Name="btnCancelAnalysis" 
                            Content="❌ Отменить анализ" 
                            Click="btnCancelAnalysis_Click"
                            Background="White"
                            Foreground="Red"
                            BorderThickness="0"
                            Margin="0,10,0,2" 
                            Padding="5,2"
                            HorizontalAlignment="Stretch"/>

                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Первый разделитель (между кнопками и первым текстовым блоком) -->
        <GridSplitter Grid.Column="1" 
                      HorizontalAlignment="Stretch" 
                      Width="5" 
                      Background="LightGray"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Левый текстовый блок -->
        <TextBox Grid.Column="2" 
                 x:Name="txtOutput1" 
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True"
                 Text="Оригинальный текст файла..."/>

        <!-- Второй разделитель -->
        <GridSplitter Grid.Column="3" 
                      HorizontalAlignment="Stretch" 
                      Width="5" 
                      Background="LightGray"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Средний список товаров -->
        <ListView Grid.Column="4" 
                  x:Name="lstProducts"
                  FontFamily="Consolas"
                  FontSize="12"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Товар" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Третий разделитель (после списка товаров) -->
        <GridSplitter Grid.Column="5" 
                      HorizontalAlignment="Stretch" 
                      Width="5" 
                      Background="LightGray"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Третий текстовый блок -->
        <TextBox Grid.Column="6" 
                 x:Name="txtOutput3" 
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True"
                 Text="Результаты поиска товаров..."/>

        <!-- Четвертый разделитель (после третьего текстового блока) -->
        <GridSplitter Grid.Column="7" 
                      HorizontalAlignment="Stretch" 
                      Width="5" 
                      Background="LightGray"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Четвертый текстовый блок -->
        <TextBox Grid.Column="8" 
                 x:Name="txtOutput4" 
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 AcceptsReturn="True"
                 Text="Логи анализа файла..."/>
    </Grid>
</Window>