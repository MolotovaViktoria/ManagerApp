<Page x:Class="ManagerApp.Pages.PngPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PngPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель шагов -->
        <Grid Grid.Row="0" 
      Background="#F5F5F5"
      Height="80"
      Margin="0">
            <!-- Центрирующий контейнер -->
            <StackPanel Orientation="Horizontal" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- Шаг 1: Загрузка заявки (активный) -->
                <Border Background="#E2542A"
                CornerRadius="6"

                Width="185"
                Height="50"
                Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- Номер шага -->
                        <Border Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="White"
                        Margin="0,0,8,0">
                            <TextBlock Text="1"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#E2542A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <!-- Название шага -->
                        <TextBlock Text="Загрузка заявки"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>



                <!-- Шаг 2: Сопоставление товаров (неактивный) -->
                <Border Background="#E2542A"
                CornerRadius="6"
                Width="185"
                Height="50"
                 Opacity="0.5"
                Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- Номер шага -->
                        <Border Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="White"
                        Margin="0,0,8,0">
                            <TextBlock Text="2"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#E2542A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <!-- Название шага -->
                        <TextBlock Text="Сопоставление товаров"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <!-- Шаг 3: Редактирование цены (неактивный) -->
                <Border Background="#E2542A"
                CornerRadius="6"
                Width="185"
                                         Opacity="0.5"
                Height="50"
                Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- Номер шага -->
                        <Border Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="White"
                        Margin="0,0,8,0">
                            <TextBlock Text="3"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#E2542A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <!-- Название шага -->
                        <TextBlock Text="Редактирование цены"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <!-- Шаг 4: Формирование счета (неактивный) -->
                <Border Background="#E2542A"
                CornerRadius="6"
                Width="185"
                Height="50"
    Opacity="0.5"
                Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!-- Номер шага -->
                        <Border Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="White"
                        Margin="0,0,8,0">
                            <TextBlock Text="4"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#E2542A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <!-- Название шага -->
                        <TextBlock Text="Формирование счета"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Основная контентная область -->
        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="0.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - Текст файла -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель инструментов -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10" CornerRadius="5">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnLoadImage" Content="Открыть другой"
                    Background="#E2542A" Foreground="White" FontWeight="Bold"
                    Padding="10,5" Margin="10,0,0,0" Click="btnLoadImage_Click"/>

                                <!--<Button x:Name="btnAI" Content="Сформировать список товаров с помощью ИИ"
                    Background="#E2542A" Foreground="White" FontWeight="Bold"
                    Padding="10,5" Margin="10,0,0,0" Click="btnAI_Click"/>

                                <Button x:Name="btnMath" Content="Сформировать список товаров с помощью алгоритма"
                    Background="#E2542A" Foreground="White" FontWeight="Bold"
                    Padding="10,5" Margin="10,0,0,0" Click="btnMath_Click"/>-->
                            </StackPanel>

                            <!-- Панель прогресса (добавлено) -->
                            <Grid x:Name="progressPanel" Visibility="Collapsed" Margin="10,5,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Прогресс-бар -->
                                <ProgressBar x:Name="progressBar" Grid.Column="0" Height="20" 
                        Minimum="0" Maximum="100" Value="0"
                        Background="#E0E0E0" Foreground="#E2542A"/>

                                <!-- Текст статуса -->
                                <TextBlock x:Name="statusText" Grid.Column="1" Margin="10,0,0,0"
                      VerticalAlignment="Center" FontWeight="Medium"
                      Foreground="#333333" Text="Обработка..."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Информация о файле и предпросмотр изображения -->
                    <Grid Grid.Row="1" Margin="10,5,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Информация о файле -->
                        <TextBlock x:Name="FileInfoTextBlock" Grid.Row="0"
                                   TextWrapping="Wrap" Margin="0,0,0,5"/>

                        <!-- Предпросмотр изображения -->
                        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" 
                                Background="WhiteSmoke" MaxHeight="200">
                            <Image x:Name="ImagePreview" 
                                   Stretch="Uniform" 
                                   Visibility="Collapsed"/>
                        </Border>
                    </Grid>

                    <!-- Область текста с виртуализацией -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Background="White" Margin="10,10,10,10">
                        <ItemsControl x:Name="textItemsControl" Background="White">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                           VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Правая часть - Список товаров -->
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Background="#F8F9FA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0" Background="#E2542A" Padding="15,10">
                        <TextBlock Text="Список товаров" Foreground="White" FontWeight="Bold"
                                   FontSize="14" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Контент правой части -->
                    <Border Grid.Row="1" Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Список выбранных ячеек -->
                            <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                                <ListView x:Name="lvSelectedCells" Background="White" 
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Наименование товара" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}" 
                                                                   Margin="5,2" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>

                            <!-- Панель с кнопкой очистки -->
                            <Border Grid.Row="1" Background="#F5F5F5" Padding="8" CornerRadius="4">
                                <Button x:Name="btnClearList" Content="ОЧИСТИТЬ ВЕСЬ СПИСОК"
                                        Background="#E2542A" Foreground="White" FontWeight="Bold"
                                        Click="btnClearList_Click"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Панель кнопок навигации -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка "Назад" -->
                <Button x:Name="btnBack" Grid.Column="1" Content="НАЗАД" Width="120" Height="40"
                        Background="#E2542A" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0"  Click="btnBack_Click"/>

                <!-- Кнопка "Далее" -->
                <Button x:Name="btnNext" Grid.Column="3" Content="ДАЛЕЕ" Width="120" Height="40"
                        Background="#E2542A" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0" Click="btnNext_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>