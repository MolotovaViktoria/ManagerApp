<Window x:Class="ManagerApp.Pages.TrainModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManagerApp.Pages"
        mc:Ignorable="d"
       Title="Обучение модели распознавания товаров" 
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#f5f5f5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и статус -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Обучение модели ML" 
                      FontSize="18" 
                      FontWeight="Bold" 
                      Foreground="#2c3e50"
                      Margin="0,0,0,10"/>

            <Border Background="#e8f4fd" 
                    BorderBrush="#b8daff" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Padding="10">
                <TextBlock Text="{Binding StatusMessage}" 
                          FontWeight="SemiBold"
                          Foreground="#004085"
                          TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Область текста для классификации -->
        <GroupBox Grid.Row="1" 
                 Header="Текст для классификации:" 
                 Margin="0,15,0,10"
                 FontWeight="SemiBold">
            <TextBox x:Name="TextToClassify" 
                    Text="{Binding CurrentText, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True" 
                    VerticalScrollBarVisibility="Auto"
                    FontSize="14"
                    Background="White"
                    BorderThickness="1"
                    Padding="10"
                    TextWrapping="Wrap"/>
        </GroupBox>

        <!-- Результат классификации -->
        <GroupBox Grid.Row="2" 
                 Header="Результат классификации модели:" 
                 Margin="0,0,0,10"
                 FontWeight="SemiBold">
            <StackPanel>
                <TextBlock Text="{Binding ClassificationResult}" 
                          FontWeight="Bold" 
                          FontSize="14"
                          Margin="0,0,0,5"/>
                <TextBlock Text="{Binding ConfidenceText}" 
                          Foreground="#666"
                          FontSize="12"/>
                <TextBlock Text="{Binding ModelInfo}" 
                          Foreground="#888"
                          FontSize="11"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Прогресс -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Value="{Binding ProgressPercentage}" 
                        Height="20"
                        Background="#e9ecef"
                        Foreground="#007bff"/>

            <TextBlock Grid.Column="1"
                      Text="{Binding ProgressText}"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      FontWeight="SemiBold"/>
        </Grid>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="✅ Это ТОВАР" 
                    Command="{Binding MarkAsProductCommand}"
                    Background="#28a745" 
                    Foreground="White"
                    Padding="20,8" 
                    Margin="0,0,10,0"
                    FontWeight="Bold"
                    FontSize="13"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="❌ Это НЕ товар" 
                    Command="{Binding MarkAsNotProductCommand}"
                    Background="#dc3545" 
                    Foreground="White"
                    Padding="20,8"
                    Margin="10,0,10,0"
                    FontWeight="Bold"
                    FontSize="13"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="⏭️ Пропустить" 
                    Command="{Binding SkipCommand}"
                    Background="#6c757d" 
                    Foreground="White"
                    Padding="20,8"
                    Margin="10,0,0,0"
                    FontWeight="SemiBold"
                    FontSize="13"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>