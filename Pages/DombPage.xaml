<Page x:Class="ManagerApp.Pages.DombPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Менеджер товаров" 
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель шагов -->
        <Grid Grid.Row="0" 
              Background="#F5F5F5"
              Height="70"
              VerticalAlignment="Center"
              Margin="15,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пустое пространство слева -->
                <Grid Grid.Column="0"/>

                <!-- Шаг 1: Загрузка заявки (активный) -->
                <Border Grid.Column="1"
                        Background="#E2542A"
                        CornerRadius="8"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Загрузка заявки"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="2"/>

                <!-- Шаг 2: Анализ данных (неактивный) -->
                <Border Grid.Column="3"
                        Background="#E2542A"
                        CornerRadius="8"
                        Opacity="0.5"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Сопоставление товаров"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="4"/>

                <!-- Шаг 3: Проверка (неактивный) -->
                <Border Grid.Column="5"
                        Background="#E2542A"
                        CornerRadius="8"
                        Opacity="0.5"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Редактирование цены"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="6"/>

                <!-- Шаг 4: Результат (неактивный) -->
                <Border Grid.Column="7"
                        Background="#E2542A"
                        CornerRadius="8"
                        Opacity="0.5"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Формирование счета"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Пустое пространство справа -->
                <Grid Grid.Column="8"/>
            </Grid>
        </Grid>

        <!-- Контентная область для загрузки файла -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="10,5,10,5"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">

            <Grid>
                <!-- Основная область для загрузки файла -->
                <Border Name="DropArea"
                        Background="#FFF8F5"
                        BorderBrush="#E2542A"
                        BorderThickness="2"
                        CornerRadius="12" 
                        Margin="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Padding="40">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Иконка загрузки -->
                        <Viewbox Width="96" Height="96" Margin="0,0,0,30">
                            <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"
                                  Fill="#E2542A"
                                  Stretch="Uniform"/>
                        </Viewbox>

                        <!-- Текст инструкции -->
                        <TextBlock Text="Перетащите файл заявки сюда или"
                                   FontSize="20"
                                   Foreground="#555555"
                                   TextAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <!-- Кнопка выбора файла -->
                        <Button Name="SelectFileButton"
                                Content="Выберите файл"
                                Background="#E2542A"
                                Foreground="White"
                                BorderBrush="#C44A24"
                                Padding="30,15"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                HorizontalAlignment="Center"
                                MinWidth="180"
                                Click="SelectFileButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#C44A24"/>
                                            <Setter Property="BorderBrush" Value="#A83E1E"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#A83E1E"/>
                                            <Setter Property="BorderBrush" Value="#8A3319"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Информация о поддерживаемых форматах -->
                        <TextBlock Text="Поддерживаемые форматы: Word (.docx, .dotx, .docm, .dotm), PDF (.pdf), Excel (.xlsx, .xls, .xlsm, .xlsb, .csv)"
                                   FontSize="14"
                                   Foreground="#888888"
                                   TextAlignment="Center"
                                   Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Текст или область для отображения загруженного файла -->
                <TextBlock Name="FileNameText"
                           Text=""
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,30"
                           FontSize="16"
                           Foreground="#555555"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Page>