<Page x:Class="ManagerApp.Pages.WorldPdfFile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WorldPdfFile">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель шагов -->
        <Grid Grid.Row="0" Background="#F5F5F5" Height="70" VerticalAlignment="Center" Margin="15,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Шаг 1: Загрузка заявки (активный) -->
                <Border Grid.Column="1" Background="#E2542A" CornerRadius="8" Opacity="0.5" Margin="2">
                    <TextBlock Text="Загрузка заявки" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" FontWeight="Medium" Foreground="White" Margin="10"/>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="2"/>

                <!-- Шаг 2: Анализ данных (активный) -->
                <Border Grid.Column="3" Background="#E2542A" CornerRadius="8" Margin="2">
                    <TextBlock Text="Сопоставление товаров" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" FontWeight="Bold" Foreground="White" Margin="10"/>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="4"/>

                <!-- Шаг 3: Проверка (неактивный) -->
                <Border Grid.Column="5" Background="#E2542A" CornerRadius="8" Opacity="0.5" Margin="2">
                    <TextBlock Text="Редактирование цены" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" FontWeight="Medium" Foreground="White" Margin="10"/>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="6"/>

                <!-- Шаг 4: Результат (неактивный) -->
                <Border Grid.Column="7" Background="#E2542A" CornerRadius="8" Opacity="0.5" Margin="2">
                    <TextBlock Text="Формирование счета" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" FontWeight="Medium" Foreground="White" Margin="10"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Основная контентная область -->
        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.7*"/>
                <ColumnDefinition Width="0.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - Текст файла -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель инструментов -->
                    <!-- Панель инструментов -->
                    <Border Grid.Row="0" Background="#F5F5F5" Padding="10" CornerRadius="5">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnLoadExcel" Content="Открыть другой"
                    Background="#E2542A" Foreground="White" FontWeight="Bold"
                    Padding="10,5" Margin="10,0,0,0" Click="btnLoadExcel_Click"/>

                                <Button x:Name="btnAI" Content="Сформировать список товаров с помощью ИИ"
                    Background="#E2542A" Foreground="White" FontWeight="Bold"
                    Padding="10,5" Margin="10,0,0,0" Click="btnAI_Click"/>

                                <Button x:Name="btnMath" Content="Сформировать список товаров с помощью алгоритма"
                    Background="#E2542A" Foreground="White" FontWeight="Bold"
                    Padding="10,5" Margin="10,0,0,0" Click="btnMath_Click"/>
                            </StackPanel>

                            <!-- Панель прогресса (добавлено) -->
                            <Grid x:Name="progressPanel" Visibility="Collapsed" Margin="10,5,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Прогресс-бар -->
                                <ProgressBar x:Name="progressBar" Grid.Column="0" Height="20" 
                        Minimum="0" Maximum="100" Value="0"
                        Background="#E0E0E0" Foreground="#E2542A"/>

                                <!-- Текст статуса -->
                                <TextBlock x:Name="statusText" Grid.Column="1" Margin="10,0,0,0"
                      VerticalAlignment="Center" FontWeight="Medium"
                      Foreground="#333333" Text="Обработка..."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Область текста с виртуализацией -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Background="White" Margin="10,10,10,10">
                        <ItemsControl x:Name="textItemsControl" Background="White">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                           VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Правая часть - Список товаров -->
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0" Background="#F8F9FA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0" Background="#E2542A" Padding="15,10">
                        <TextBlock Text="Список товаров" Foreground="White" FontWeight="Bold"
                                   FontSize="14" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Контент правой части -->
                    <Border Grid.Row="1" Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Список выбранных ячеек -->
                            <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                                <ListView x:Name="lvSelectedCells" Background="White" 
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Наименование товара" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}" 
                                                                   Margin="5,2" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>

                            <!-- Панель с кнопкой очистки -->
                            <Border Grid.Row="1" Background="#F5F5F5" Padding="8" CornerRadius="4">
                                <Button x:Name="btnClearList" Content="ОЧИСТИТЬ ВЕСЬ СПИСОК"
                                        Background="#E2542A" Foreground="White" FontWeight="Bold"
                                        Click="btnClearList_Click"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Панель кнопок навигации -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка "Назад" -->
                <Button x:Name="btnBack" Grid.Column="1" Content="НАЗАД" Width="120" Height="40"
                        Background="#E2542A" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0"  Click="btnBack_Click"/>

                <!-- Кнопка "Далее" -->
                <Button x:Name="btnNext" Grid.Column="3" Content="ДАЛЕЕ" Width="120" Height="40"
                        Background="#E2542A" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0" Click="btnNext_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>