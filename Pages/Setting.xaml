<Page x:Class="ManagerApp.Pages.Setting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Настройки"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка страницы -->
        <Border Grid.Row="0"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <TextBlock Text="НАСТРОЙКИ"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основная область с настройками -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="20,20,20,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30">

                    <!-- Настройка НДС -->
                    <Border BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,25"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="НАЛОГОВАЯ СТАВКА (НДС)"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Укажите процент НДС, который будет применяться при расчете цен"
                                       FontSize="14"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"
                                       Margin="0,0,20,0"/>

                            <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtVAT"
                                         Grid.Column="0"
                                         Width="120"
                                         Height="45"
                                         FontSize="16"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding VAT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="txtVAT_PreviewTextInput"
                                         LostFocus="txtVAT_LostFocus">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="#E2542A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <TextBlock Grid.Column="2"
                                           Text="%"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Настройка выбора сотрудника -->
                    <Border BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,25"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Сотрудник:"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Выберите сотрудника"
                                       FontSize="14"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"
                                       Margin="0,0,20,0"/>

                            <ComboBox x:Name="cmbEmployees"
          Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
          Width="350"
          Height="45"
          FontSize="14"
          VerticalContentAlignment="Center"
          ItemsSource="{Binding Employees}"
          SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
          IsEditable="False">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                <Setter Property="Foreground" Value="#999999"/>
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="#E2542A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <Border Width="32" Height="32" CornerRadius="16"
                        Background="#E2542A" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initials}"
                               Foreground="White"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding name}"
                               FontWeight="SemiBold"
                               FontSize="13"/>
                                                <TextBlock Text="{Binding work_position}"
                               FontSize="11"
                               Foreground="#666666"
                               Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Настройка пути OCR --><!--
                    <Border BorderBrush="#E0E0E0"
        BorderThickness="0,0,0,1"
        Padding="0,0,0,25"
        Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="ПУТЬ К ЯЗЫКОВОМУ ПАКЕТУ OCR"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#333333"
                   Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Укажите путь к файлу rus.traineddata для работы с OCR"
                   FontSize="14"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   Margin="0,0,20,0"/>

                            <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="400">

                                --><!-- Поле для отображения пути --><!--
                                <TextBox x:Name="txtOCRPath"
                     Height="45"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Text="{Binding OCRPath, Mode=OneWay}"
                     Margin="0,0,0,10">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Setter Property="Background" Value="#F8F8F8"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                --><!-- Кнопки для работы с путем --><!--
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnBrowseOCR"
                        Content="ОБЗОР..."
                        Width="100"
                        Height="35"
                        Background="#F0F0F0"
                        Foreground="#333333"
                        FontWeight="SemiBold"
                        FontSize="12"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0"
                        Margin="0,0,10,0"
                        Click="btnBrowseOCR_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button x:Name="btnTestOCRPath"
                        Content="ПРОВЕРИТЬ"
                        Width="100"
                        Height="35"
                        Background="#F0F0F0"
                        Foreground="#333333"
                        FontWeight="SemiBold"
                        FontSize="12"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0"
                        Click="btnTestOCRPath_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>-->

                    <!-- Обновление кеша -->
                    <Border BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,25"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="ОБНОВЛЕНИЕ ДАННЫХ"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Принудительное обновление кеша данных из Bitrix"
                                       FontSize="14"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"
                                       Margin="0,0,20,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Приложение будет приостановлено на время обновления"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="#999999"
                                       TextWrapping="Wrap"
                                       Margin="0,10,20,0"/>

                            <Button x:Name="btnRefreshCache"
                                    Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                    Content="ОБНОВИТЬ КЕШ"
                                    Width="250"
                                    Height="45"
                                    Background="#F0F0F0"
                                    Foreground="Black"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="btnRefreshCache_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#45a049"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#cccccc"/>
                                                <Setter Property="Foreground" Value="#666666"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Руководство -->
                    <Border BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,25"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="ДОКУМЕНТАЦИЯ"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,15"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Открыть руководство пользователя"
                                       FontSize="14"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"
                                       Margin="0,0,20,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Файл будет открыт в соответствующем приложении"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="#999999"
                                       TextWrapping="Wrap"
                                       Margin="0,10,20,0"/>

                            <Button x:Name="btnReadManual"
                                    Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                    Content="ОТКРЫТЬ РУКОВОДСТВО"
                                    Width="250"
                                    Height="45"
                                     Background="#F0F0F0"
                                     Foreground="Black"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="btnReadManual_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#cccccc"/>
                                                <Setter Property="Foreground" Value="#666666"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Информационный блок -->
                    <Border Background="#F8F8F8"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="20,15">
                        <StackPanel>
                            <TextBlock Text="ИНФОРМАЦИЯ"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,10"/>

                            <TextBlock TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="#666666">
                                <Run Text="Настройки НДС автоматически сохраняются при изменении значения."/>
                                <LineBreak/>
                                <Run Text="Значение НДС применяется для расчета цен во всем приложении."/>
                                <LineBreak/>
                                <Run Text="ID выбранного сотрудника сохраняется в файл setting_id_sotrudmik.txt."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Панель кнопок - только Сохранить и Закрыть -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="20,15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSave"
                        Grid.Column="1"
                        Content="СОХРАНИТЬ"
                        Width="140"
                        Height="45"
                        Background="#E2542A"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Click="btnSave_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D1431F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="btnClose"
                        Grid.Column="3"
                        Content="ЗАКРЫТЬ"
                        Width="140"
                        Height="45"
                        Background="#F0F0F0"
                        Foreground="#333333"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0"
                        Click="btnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>