<Page x:Class="ManagerApp.Pages.Setting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Настройки"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка страницы (оставил только одну) -->
        <Border Grid.Row="0"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <TextBlock Text="НАСТРОЙКИ"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основная область с настройками -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="20,20,20,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30">

                    <!-- Настройка НДС -->
                    <Border BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,25"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Заголовок настройки НДС -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="НАЛОГОВАЯ СТАВКА (НДС)"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,15"/>

                            <!-- Описание -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Укажите процент НДС, который будет применяться при расчете цен"
                                       FontSize="14"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"
                                       Margin="0,0,20,0"/>

                            <!-- Поле ввода НДС -->
                            <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtVAT"
                                         Grid.Column="0"
                                         Width="120"
                                         Height="45"
                                         FontSize="16"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding VAT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="txtVAT_PreviewTextInput"
                                         LostFocus="txtVAT_LostFocus">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="#E2542A"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Процент -->
                                <TextBlock Grid.Column="2"
                                           Text="%"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Раздел проверок -->
                    <Border BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,25"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Заголовок раздела проверок -->
                            <TextBlock Text="ПРОВЕРКИ ПОДКЛЮЧЕНИЯ"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,25"/>

                            <!-- Кнопка проверки сети -->
                            <Button x:Name="btnCheckInternet"
                                    Content="ПРОВЕРИТЬ ПОДКЛЮЧЕНИЕ К ИНТЕРНЕТУ"
                                    Height="50"
                                    Background="#F0F0F0"
                                    Foreground="#333333"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    BorderThickness="1"
                                    BorderBrush="#E0E0E0"
                                    Margin="0,0,0,15"
                                    Click="btnCheckInternet_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E2542A"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Кнопка проверки API -->
                            <Button x:Name="btnCheckApi"
                                    Content="ПРОВЕРИТЬ API"
                                    Height="50"
                                    Background="#F0F0F0"
                                    Foreground="#333333"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    BorderThickness="1"
                                    BorderBrush="#E0E0E0"
                                    Margin="0,0,0,15"
                                    Click="btnCheckApi_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E2542A"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Кнопка проверки Bitrix -->
                            <Button x:Name="btnCheckBitrix"
                                    Content="ПРОВЕРИТЬ ПОДКЛЮЧЕНИЕ К BITRIX"
                                    Height="50"
                                    Background="#F0F0F0"
                                    Foreground="#333333"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    BorderThickness="1"
                                    BorderBrush="#E0E0E0"
                                    Click="btnCheckBitrix_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E2542A"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Информационный блок -->
                    <Border Background="#F8F8F8"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="20,15">
                        <StackPanel>
                            <TextBlock Text="ИНФОРМАЦИЯ"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,10"/>

                            <TextBlock TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="#666666">
                                <Run Text="Настройки НДС автоматически сохраняются при изменении значения."/>
                                <LineBreak/>
                                <Run Text="Значение НДС применяется для расчета цен во всем приложении."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Панель кнопок -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="20,15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка "Сохранить" -->
                <Button x:Name="btnSave"
                        Grid.Column="1"
                        Content="СОХРАНИТЬ"
                        Width="140"
                        Height="45"
                        Background="#E2542A"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Click="btnSave_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Кнопка "Закрыть" -->
                <Button x:Name="btnClose"
                        Grid.Column="3"
                        Content="ЗАКРЫТЬ"
                        Width="140"
                        Height="45"
                        Background="#F0F0F0"
                        Foreground="#333333"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0"
                        Click="btnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>