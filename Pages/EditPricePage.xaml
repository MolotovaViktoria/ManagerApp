<Page x:Class="ManagerApp.Pages.EditPricePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManagerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Редактирование цены"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель шагов -->
        <Grid Grid.Row="0" 
              Background="#F5F5F5"
              Height="70"
              VerticalAlignment="Center"
              Margin="15,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="0.2*" MaxWidth="20"/>
                    <ColumnDefinition Width="0.8*" MinWidth="160" MaxWidth="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Пустое пространство слева -->
                <Grid Grid.Column="0"/>

                <!-- Шаг 1: Загрузка заявки -->
                <Border Grid.Column="1"
                        Opacity="0.5"
                        Background="#E2542A"
                        CornerRadius="8"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Загрузка заявки"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="2"/>

                <!-- Шаг 2: Сопоставление товаров -->
                <Border Grid.Column="3"
                        Opacity="0.5"
                        Background="#E2542A"
                        CornerRadius="8"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Сопоставление товаров"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="4"/>

                <!-- Шаг 3: Редактирование цены (активный) -->
                <Border Grid.Column="5"
                        Background="#E2542A"
                        CornerRadius="8"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Редактирование цены"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Промежуток -->
                <Grid Grid.Column="6"/>

                <!-- Шаг 4: Формирование счета -->
                <Border Grid.Column="7"
                        Background="#E2542A"
                        CornerRadius="8"
                        Opacity="0.5"
                        Margin="2">
                    <Viewbox MaxWidth="250" MaxHeight="45">
                        <Border Width="180" Height="45"
                                Background="Transparent">
                            <TextBlock Text="Формирование счета"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Foreground="White"/>
                        </Border>
                    </Viewbox>
                </Border>

                <!-- Пустое пространство справа -->
                <Grid Grid.Column="8"/>
            </Grid>
        </Grid>

        <!-- Основная область с таблицей -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="20,10,20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок таблицы -->
                <Border Grid.Row="0"
                        Background="#F8F8F8"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="20,15">
                    <TextBlock Text="РЕДАКТИРОВАНИЕ ЦЕН"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#333333"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Панель с НДС и итогами -->
                <Border Grid.Row="1"
                        Background="#F0F0F0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- НДС -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="10,0">
                            <TextBlock Text="НДС: "
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtVATValue"
                                       Text="20"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#E2542A"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"/>
                            <TextBlock Text="%"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Итоговая сумма -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="20,0">
                            <TextBlock Text="Итого: "
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTotalSum"
                                       Text="0.00"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#E2542A"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"/>
                            <TextBlock Text=" ₽"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Кнопка пересчета -->
                        <Button Grid.Column="3"
                                Content="ПЕРЕСЧИТАТЬ"
                                Width="120"
                                Height="35"
                                Background="#E2542A"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="12"
                                BorderThickness="0"
                                Click="btnRecalculate_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Таблица товаров -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <DataGrid x:Name="dataGridProducts"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="None"
                              RowHeight="50"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="White"
                              BorderThickness="0"
                              HorizontalGridLinesBrush="#F0F0F0"
                              VerticalGridLinesBrush="#F0F0F0"
                              LoadingRow="DataGrid_LoadingRow"
                              CellEditEnding="DataGrid_CellEditEnding">

                        <DataGrid.Columns>
                            <!-- Колонка 1: Наименование товара (из заявки) -->
                            <DataGridTextColumn Header="НАИМЕНОВАНИЕ ТОВАРА"
                                                Binding="{Binding OriginalProductName}"
                                                Width="300"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Колонка 2: Товар из Bitrix -->
                            <DataGridTextColumn Header="ТОВАР ИЗ BITRIX"
                                                Binding="{Binding BitrixProductName}"
                                                Width="500"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Колонка 3: Цена из Bitrix -->
                            <DataGridTextColumn Header="РОЗНИЧНАЯ ЦЕНА"
                                                Binding="{Binding BitrixPrice, StringFormat='{}{0:#,##0.00} ₽'}"
                                                Width="140"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Колонка 4: Закупочная цена -->
                            <DataGridTextColumn Header="ЗАКУПОЧНАЯ ЦЕНА"
                    Binding="{Binding PurchasingPrice, StringFormat='{}{0:#,##0.00} ₽'}"
                    Width="140"
                    IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#1976D2"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Остальные колонки сдвигаются на 1 позицию -->
                            <!-- Колонка 5: Ввод своей цены (была 4) -->
                            <!-- Колонка 6: Количество (была 5) -->
                            <!-- и т.д. -->

                            <!-- Колонка 4: Ввод своей цены -->
                            <DataGridTemplateColumn Header="СВОЯ ЦЕНА"
                                                    Width="140">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CustomPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="120"
                                                 Height="30"
                                                 FontSize="13"
                                                 TextAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 BorderBrush="#E0E0E0"
                                                 BorderThickness="1"
                                                 Padding="5,0"
                                                 PreviewTextInput="TextBox_PreviewTextInput"
                                                 LostFocus="TextBox_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#E2542A"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Колонка 5: Количество -->
                            <DataGridTemplateColumn Header="КОЛ-ВО"
                                                    Width="100">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="80"
                                                 Height="30"
                                                 FontSize="13"
                                                 TextAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 BorderBrush="#E0E0E0"
                                                 BorderThickness="1"
                                                 Padding="5,0"
                                                 PreviewTextInput="TextBoxQuantity_PreviewTextInput"
                                                 LostFocus="TextBox_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#E2542A"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Колонка 6: Ед. измерения -->
                            <DataGridTextColumn Header="ЕД. ИЗМ."
                                                Binding="{Binding Unit}"
                                                Width="100"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Колонка 7: НДС -->
                            <DataGridTextColumn Header="НДС"
                                                Binding="{Binding VAT, StringFormat='{}{0}%'}"
                                                Width="80"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Колонка 8: Цена с НДС -->
                            <DataGridTextColumn Header="ЦЕНА С НДС"
                                                Binding="{Binding PriceWithVAT, StringFormat='{}{0:#,##0.00} ₽'}"
                                                Width="140"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#E2542A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Колонка 9: Сумма с НДС -->
                            <DataGridTextColumn Header="СУММА С НДС"
                                                Binding="{Binding TotalWithVAT, StringFormat='{}{0:#,##0.00} ₽'}"
                                                Width="140"
                                                IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#E2542A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Панель кнопок навигации -->
        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="20,15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка "Назад" -->
                <Button x:Name="btnBack"
                        Grid.Column="1"
                        Content="НАЗАД"
                        Width="140"
                        Height="45"
                        Background="#E2542A"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Click="btnBack_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Кнопка "Далее" -->
                <Button x:Name="btnNext"
                        Grid.Column="3"
                        Content="ДАЛЕЕ"
                        Width="140"
                        Height="45"
                        Background="#E2542A"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Click="btnNext_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
